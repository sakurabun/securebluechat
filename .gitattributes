# Keep scripts LF so F-Droid's Linux build server and GitHub Actions can execute them.
* text=auto eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
gradlew text eol=lf
gradlew.bat text eol=crlf

# Never let Git touch binaries
*.png binary
*.jpg binary
*.jar binary
*.pptx binary
*.jks binary
*.keystore binary
